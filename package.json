{
  "name": "trinity-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:story": "python3 scripts/check_story_meta.py && python3 scripts/check_story_length.py",
    "prebuild": "npm run check:story",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run check:story && DEPLOY_TARGET=cf vite build && npx wrangler@latest pages deploy dist --project-name=trinity",
    "deploy:cf": "npm run check:story && DEPLOY_TARGET=cf vite build && npx wrangler@latest pages deploy dist --project-name=trinity",
    "deploy:ghredirect": "npx gh-pages -d gh-redirect --dotfiles"
  },
  "dependencies": {
    "framer-motion": "^12.42.0",
    "lenis": "^1.3.25",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
