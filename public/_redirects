# A missing /assets/* file must 404, never fall through to the SPA rule below.
# Otherwise a chunk that has not propagated yet is answered with index.html at
# status 200, the browser caches HTML under a .js URL, and every later dynamic
# import of that chunk fails for as long as the entry lives in its cache.
/assets/*  /assets/:splat  404

# SPA fallback: serve the app for clean paths (/deck, /insight, /analyze).
# Real files (assets/*, og-cover.png, robots.txt, sitemap.xml) are served before this.
/*  /index.html  200
